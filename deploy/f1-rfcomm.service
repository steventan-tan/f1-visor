[Unit]
Description=Bind the F1 visor HC-06 serial device
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=oneshot
EnvironmentFile=/etc/f1-visor/bluetooth.env
ExecStartPre=-/usr/bin/rfcomm release 0
ExecStart=/usr/bin/rfcomm bind 0 ${BT_MAC} ${BT_CHANNEL}
ExecStop=-/usr/bin/rfcomm release 0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
